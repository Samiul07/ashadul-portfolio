# Create a Sanity project at https://www.sanity.io/manage, then add its values here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret that must match the "secret" configured on the Sanity webhook
# (dashboard: Manage project -> API -> Webhooks -> Create webhook). The webhook
# POSTs to https://ashadul.design/api/revalidate and this value is checked
# before any cache is cleared. Generate a long random string, e.g.:
#   openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
